		track(espHealthBtn.button.MouseButton1Click:Connect(function()
			espHealthBars = not espHealthBars; ENH.GamePrefs.ESPHealthBars = espHealthBars; scheduleSaveSettings(); refreshAllESP(); updateESPButtons()
		end))

		makeNumberControl({
			Title = "ESP Max Distance", HideTitle = true, LabelPrefix = "ESP distance: ",
			Min = CONFIG.ESP.MaxDistanceMin, Max = CONFIG.ESP.MaxDistanceMax, Value = espMaxDistance,
			OnChanged = function(v)
				espMaxDistance = v; ENH.GamePrefs.ESPMaxDistance = v; scheduleSaveSettings()
