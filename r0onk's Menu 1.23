	makeSection("Server", false, function()
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 34)
		row.BackgroundTransparency = 1
		row.LayoutOrder = nextOrder()
		row.Parent = currentUIParent or frame

		local rejoinBtn = Instance.new("TextButton")
		rejoinBtn.Size = UDim2.new(0.5, -4, 1, 0)
		rejoinBtn.Text = "Rejoin Server"
		rejoinBtn.BackgroundColor3 = Color3.fromRGB(48, 51, 61)
		rejoinBtn.TextColor3 = THEME.TEXT
		rejoinBtn.Font = Enum.Font.GothamMedium
		rejoinBtn.TextSize = 11
		rejoinBtn.BorderSizePixel = 0
		rejoinBtn.AutoButtonColor = false
		rejoinBtn.Parent = row
		addCorner(rejoinBtn, 9)

		local hopBtn = rejoinBtn:Clone()
		hopBtn.Text = "Server Hop"
		hopBtn.Position = UDim2.new(0.5, 4, 0, 0)
		hopBtn.Parent = row

		track(rejoinBtn.MouseButton1Click:Connect(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
		end))
		track(hopBtn.MouseButton1Click:Connect(function()
			task.spawn(function()
				local ok, body = pcall(function()
					return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true")
				end)
				if not ok then return end
				local parsedOk, decoded = pcall(HttpService.JSONDecode, HttpService, body)
				if not parsedOk or type(decoded) ~= "table" or type(decoded.data) ~= "table" then return end
				local servers = {}
				for _, server in ipairs(decoded.data) do
					if server.id ~= game.JobId and tonumber(server.playing) and tonumber(server.maxPlayers) and server.playing < server.maxPlayers then
						table.insert(servers, server.id)
					end
				end
				if #servers > 0 then
					TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
				end
			end)
		end))
	end)

	-- SETTINGS ===================================================
	makeSection("Settings", false, function()
		makeLabel("Hotkeys", THEME.SUBTEXT, 18, 13)

		local actions = {
			{"Open Menu", "Open"},
			{"Fly", "Fly"},
			{"Noclip", "Noclip"},
			{"Infinite Jump", "InfJump"},
			{"Aimbot", "Aimbot"},
		}

		local function keyAlreadyUsed(key, exceptAction)
			for action, existing in pairs(CONFIG.Keys) do
				if action ~= exceptAction and existing == key then return action end
			end
			return nil
		end

		local function refreshKeybindUI()
			for action, button in pairs(ENH.KeybindButtons) do
				button.Text = keyToText(CONFIG.Keys[action])
			end
			refreshHeaderGreeting()
		end

		local function beginKeyCapture(action)
			if ENH.KeyCaptureConnection then ENH.KeyCaptureConnection:Disconnect(); ENH.KeyCaptureConnection = nil end
			ENH.CapturingKeybind = true
			local button = ENH.KeybindButtons[action]
			if button then button.Text = "Press a key..." end
			if ENH.KeybindStatusLabel then ENH.KeybindStatusLabel.Text = "Listening for " .. action .. "..." end

			ENH.KeyCaptureConnection = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				ENH.KeyCaptureConnection:Disconnect()
				ENH.KeyCaptureConnection = nil
				ENH.CapturingKeybind = false

				if input.KeyCode == Enum.KeyCode.Escape then
					if ENH.KeybindStatusLabel then ENH.KeybindStatusLabel.Text = "Key change cancelled." end
					refreshKeybindUI()
					return
				end

				local conflict = keyAlreadyUsed(input.KeyCode, action)
				if conflict then
					if ENH.KeybindStatusLabel then ENH.KeybindStatusLabel.Text = keyToText(input.KeyCode) .. " is already assigned to " .. conflict .. "." end
					refreshKeybindUI()
					return
				end

				CONFIG.Keys[action] = input.KeyCode
				ENH.AllSettings.global.Keys = ENH.AllSettings.global.Keys or {}
				ENH.AllSettings.global.Keys[action] = input.KeyCode.Name
				scheduleSaveSettings()
				if ENH.KeybindStatusLabel then ENH.KeybindStatusLabel.Text = action .. " → " .. keyToText(input.KeyCode) end
				refreshKeybindUI()
			end)
		end

		for _, info in ipairs(actions) do
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 32)
			row.BackgroundColor3 = Color3.fromRGB(48, 51, 61)
			row.BorderSizePixel = 0
			row.LayoutOrder = nextOrder()
			row.Parent = currentUIParent or frame
			addCorner(row, 8)

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, -112, 1, 0)
			label.Position = UDim2.new(0, 10, 0, 0)
			label.BackgroundTransparency = 1
			label.Text = info[1]
			label.Font = Enum.Font.Gotham
			label.TextSize = 12
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextColor3 = THEME.TEXT
			label.Parent = row

			local keyBtn = Instance.new("TextButton")
			keyBtn.Size = UDim2.new(0, 96, 0, 24)
			keyBtn.Position = UDim2.new(1, -102, 0.5, -12)
			keyBtn.BackgroundColor3 = THEME.BUTTON
			keyBtn.TextColor3 = THEME.ACCENT
			keyBtn.Font = Enum.Font.GothamBold
			keyBtn.TextSize = 11
			keyBtn.BorderSizePixel = 0
			keyBtn.AutoButtonColor = false
			keyBtn.Parent = row
			addCorner(keyBtn, 7)
			ENH.KeybindButtons[info[2]] = keyBtn
			track(keyBtn.MouseButton1Click:Connect(function() beginKeyCapture(info[2]) end))
		end

		ENH.KeybindStatusLabel = makeLabel(ENH.CanPersist and "Preferences: saving enabled" or "Preferences: session only (file API unavailable)", THEME.SUBTEXT, 20, 11)
		refreshKeybindUI()

	end)

	-- Decorative full-body r0onk avatar footer. Keeping this inside the main
	-- ScrollingFrame makes its placement deterministic: when every section is
	-- collapsed it sits naturally in the spare area below Settings, and when the
	-- menu grows it simply moves with the content instead of overlapping controls.
	do
		local avatarUserId = 32713511
		local avatarFooter = Instance.new("Frame")
		avatarFooter.Name = "r0onk_AvatarFooter"
		avatarFooter.Size = UDim2.new(1, 0, 0, 104)
		avatarFooter.BackgroundTransparency = 1
		avatarFooter.BorderSizePixel = 0
		avatarFooter.LayoutOrder = nextOrder()
		avatarFooter.ZIndex = 2
		avatarFooter.Parent = frame

		local avatar = Instance.new("ImageLabel")
		avatar.Name = "r0onk_FullAvatar"
		avatar.AnchorPoint = Vector2.new(0.5, 0.5)
		avatar.Position = UDim2.fromScale(0.5, 0.5)
		avatar.Size = UDim2.fromOffset(100, 100)
		avatar.BackgroundTransparency = 1
		avatar.BorderSizePixel = 0
		avatar.ScaleType = Enum.ScaleType.Fit
		avatar.ZIndex = 3
		-- Immediate engine thumbnail fallback so the image has something to resolve
		-- even before GetUserThumbnailAsync finishes.
		avatar.Image = "rbxthumb://type=Avatar&id=" .. avatarUserId .. "&w=420&h=420"
		avatar.Parent = avatarFooter

		-- AvatarThumbnail is Roblox's full-body thumbnail type. Retry briefly because
		-- Roblox can report a thumbnail as not ready on the first request.
		task.spawn(function()
			for _ = 1, 6 do
				if not alive or not avatar or not avatar.Parent then return end
				local ok, image, ready = pcall(function()
					return Players:GetUserThumbnailAsync(
						avatarUserId,
						Enum.ThumbnailType.AvatarThumbnail,
						Enum.ThumbnailSize.Size420x420
					)
				end)

				if ok and image and image ~= "" then
					avatar.Image = image
					if ready then return end
				end
				task.wait(0.4)
			end
		end)
	end

	local openTween = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local closeTween = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local openBusy = false

	local function animateOpen()
		if openBusy then return end
		openBusy = true
		window.Visible = true
		window.Size = UDim2.new(0, 0, 0, 0)
		rebuildPlayerList()
		local tween = TweenService:Create(window, openTween, {Size = UDim2.new(0, CONFIG.PanelWidth, 0, CONFIG.PanelHeight)})
		tween:Play()
		tween.Completed:Once(function() openBusy = false end)
	end

	local function animateClose()
		if openBusy then return end
		openBusy = true
		local tween = TweenService:Create(window, closeTween, {Size = UDim2.new(0, 0, 0, 0)})
		tween:Play()
		tween.Completed:Once(function()
			if window then window.Visible = false end
			openBusy = false
		end)
	end

	track(closeBtn.MouseButton1Click:Connect(function()
		if type(ENH.Env.r0onk_Unload) == "function" then ENH.Env.r0onk_Unload() end
	end))

	-- Drag only from the header and clamp the panel so it cannot be lost off-screen.
	do
		local dragging = false
		local dragStart
		local startPos
		track(header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				dragStart = input.Position
				startPos = window.Position
			end
		end))
		track(UserInputService.InputChanged:Connect(function(input)
			if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - dragStart
				local cam = workspace.CurrentCamera
				local viewport = cam and cam.ViewportSize or Vector2.new(1920, 1080)
				local halfW = CONFIG.PanelWidth * uiScale.Scale * 0.5
				local halfH = CONFIG.PanelHeight * uiScale.Scale * 0.5
				local minX = -viewport.X * 0.5 + halfW
				local maxX = viewport.X * 0.5 - halfW
				local minY = -viewport.Y * 0.5 + halfH
				local maxY = viewport.Y * 0.5 - halfH
				window.Position = UDim2.new(0.5, math.clamp(startPos.X.Offset + delta.X, minX, maxX), 0.5, math.clamp(startPos.Y.Offset + delta.Y, minY, maxY))
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
		end))
	end

	window:SetAttribute("Built", true)
	ENH.Env.r0onk_ToggleWindow = function()
		if not alive or not window then return end
		if not window.Visible then animateOpen() else animateClose() end
	end
end

-- ===== INPUT / LOOPS =====
local function toggleWindow()
	if ENH.Env.r0onk_ToggleWindow then
		ENH.Env.r0onk_ToggleWindow()
	end
end

track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not alive or ENH.CapturingKeybind then return end
	if gameProcessed then return end

	if typingInTextBox() and input.KeyCode ~= CONFIG.Keys.Open then return end

	if input.KeyCode == CONFIG.Keys.Open then toggleWindow(); return end
	if input.KeyCode == CONFIG.Keys.Fly then setFlying(not flying); return end
	if input.KeyCode == CONFIG.Keys.Noclip then setNoclip(not noclip); return end
	if input.KeyCode == CONFIG.Keys.InfJump then
		infJump = not infJump
		setToggleWidget(infJumpBtn, infJump, "Infinite Jump")
		return
	end
	if input.KeyCode == CONFIG.Keys.Aimbot then setAimLockEnabled(not aimLockEnabled); return end
end))

track(UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Space then
		infArmed = true
	end
end))

track(UserInputService.JumpRequest:Connect(function()
	if not alive then return end
	if not infJump then return end
	if not infArmed then return end

	infArmed = false

	local now = os.clock()
	if now - infLast < CONFIG.InfJumpCooldown then return end
	infLast = now

	local root = getHRP(getCharacter())
	if not root then return end

	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, CONFIG.InfJumpImpulse, v.Z)

	task.delay(0.12, function()
		infArmed = true
	end)
end))

track(RunService.RenderStepped:Connect(function()
	if not alive then return end

	if typingInTextBox() then
		if flying and flyVelocity then
			flyVelocity.VectorVelocity = Vector3.zero
		end
		return
	end

	if flying and hrp and flyVelocity and flyOrientation then
		local cam = workspace.CurrentCamera
		local dir = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then dir -= Vector3.yAxis end

		if dir.Magnitude > 0 then
			dir = dir.Unit
		end

		flyVelocity.VectorVelocity = dir * flySpeed
		flyOrientation.CFrame = cam.CFrame
	end

end))



-- This connection is in the admin menu's main connection bucket.
-- The existing red X disconnects it along with the rest of the menu.
track(RunService.RenderStepped:Connect(function()
	if not alive or not aimLockEnabled then
		return
	end

	-- Re-evaluate continuously so the closest valid controlled entity wins.
	local targetEntity
	local targetPosition
	aimCurrentTarget, targetEntity, targetPosition = AimCore.findBestTarget()

	if not aimCurrentTarget or not targetEntity or not targetPosition then
		if aimTargetLabel then
			aimTargetLabel.Text = "Target: None"
			aimTargetLabel.TextColor3 = THEME.SUBTEXT
		end
		return
	end

	local char = aimCurrentTarget.Character

	local cam = workspace.CurrentCamera
	if not cam then
		return
	end

	local teamName = (aimCurrentTarget.Neutral == true or aimCurrentTarget.Team == nil)
		and "Neutral"
		or aimCurrentTarget.Team.Name

	if aimTargetLabel then
		aimTargetLabel.Text =
			"Target: "
			.. aimCurrentTarget.Name
			.. " ["
			.. teamName
			.. "]"
			.. (AimCore.isSeated(char) and " [VEHICLE]" or "")
		aimTargetLabel.TextColor3 = THEME.ACCENT
	end

	-- Full-strength snap from the tested standalone version.
	cam.CFrame = CFrame.lookAt(
		cam.CFrame.Position,
		targetPosition
	)
end))

task.spawn(function()
	while alive do
		task.wait(0.1)
		if espEnabled then
			refreshAllESP()
		end
	end
end)

-- ===== PLAYER HOOKS =====
track(Players.PlayerAdded:Connect(function(otherPlayer)
	hookPlayer(otherPlayer)
	if window and window.Visible then
		rebuildPlayerList()
	end
end))

track(Players.PlayerRemoving:Connect(function(otherPlayer)
	unhookPlayer(otherPlayer)
	if window and window.Visible then
		rebuildPlayerList()
	end
end))

track(player:GetPropertyChangedSignal("Team"):Connect(function()
	if espEnabled then refreshAllESP() end

	-- Default TARGET/IGNORE states depend on our own team. Refresh both the UI
	-- and aim caches when Roblox changes it.
	AimCore.reset()
	task.defer(rebuildAimTeamButtons)

	if aimCurrentTarget and not AimCore.targetAllowed(aimCurrentTarget) then
		aimCurrentTarget = nil
		updateAimlockUI()
	end
end))

track(player:GetPropertyChangedSignal("Neutral"):Connect(function()
	if espEnabled then refreshAllESP() end

	AimCore.reset()
	task.defer(rebuildAimTeamButtons)

	if aimCurrentTarget and not AimCore.targetAllowed(aimCurrentTarget) then
		aimCurrentTarget = nil
		updateAimlockUI()
	end
end))

for _, otherPlayer in ipairs(Players:GetPlayers()) do
	hookPlayer(otherPlayer)
end

track(Teams.ChildAdded:Connect(function(child)
	if child:IsA("Team") then
		AimCore.reset()
		task.defer(rebuildAimTeamButtons)
	end
end))

track(Teams.ChildRemoved:Connect(function(child)
	if child:IsA("Team") then
		-- Keep the saved name-based preference in case the team is recreated.
		AimCore.reset()
		task.defer(rebuildAimTeamButtons)
	end
end))

-- ===== CLEAN UNLOAD =====
local unloading = false
local function cleanupMenu()
	if unloading then return end
	unloading = true

	-- Save preferences before alive flips false (debounced saves no longer run afterward).
	saveSettingsNow()

	setAimLockEnabled(false)
	setFlying(false)
	setNoclip(false)
	infJump = false
	stopBringingAll()
	setGhostMode(false)
	cleanupFlyObjects()
	destroyGhost()

	if ENH.KeyCaptureConnection then ENH.KeyCaptureConnection:Disconnect(); ENH.KeyCaptureConnection = nil end
	ENH.CapturingKeybind = false

	-- Hand WalkSpeed/JumpPower and camera ownership back to the game for this session.
	restoreGameStats(false)

	alive = false
	disconnectBucket(ENH.DynamicPlayerConnections)
	disconnectBucket(ENH.DynamicAimTeamConnections)
	disconnectBucket(perCharacterConnections)
	disconnectBucket(connections)

	for otherPlayer, bucket in pairs(playerHooks) do
		disconnectBucket(bucket)
		playerHooks[otherPlayer] = nil
	end

	if gui and gui.Parent then gui:Destroy() end
	if ENH.Env.r0onk_Unload == cleanupMenu then ENH.Env.r0onk_Unload = nil end
	ENH.Env.r0onk_ToggleWindow = nil
end

ENH.Env.r0onk_Unload = cleanupMenu

-- ===== STARTUP =====
flySpeed = clampInt(flySpeed, CONFIG.FlySpeed.Min, CONFIG.FlySpeed.Max)
walkSpeed = clampInt(walkSpeed, CONFIG.WalkSpeed.Min, CONFIG.WalkSpeed.Max)
jumpPower = clampInt(jumpPower, CONFIG.JumpPower.Min, CONFIG.JumpPower.Max)
espMaxDistance = clampInt(espMaxDistance, CONFIG.ESP.MaxDistanceMin, CONFIG.ESP.MaxDistanceMax)
aimMaxDistance = clampInt(aimMaxDistance, CONFIG.AIMLOCK.MaxDistanceMin, CONFIG.AIMLOCK.MaxDistanceMax)
buildWindow()

if player.Character then
	setupCharacter(player.Character)
end

track(player.CharacterAdded:Connect(function(char)
	setupCharacter(char)
end))
