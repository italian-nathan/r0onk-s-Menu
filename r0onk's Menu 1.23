			track(btn.MouseButton1Click:Connect(function()
				ENH.PlayerFilterMode = info[2]
				refreshPlayerFilterButtons()
				rebuildPlayerList()
			end))
		end
		refreshPlayerFilterButtons()

		playerListFrame = Instance.new("ScrollingFrame")
		playerListFrame.Size = UDim2.new(1, 0, 0, 164)
		playerListFrame.BackgroundColor3 = Color3.fromRGB(38, 41, 49)
