-- ===== PERSISTENT PREFERENCES =====
-- Preferences are optional: the menu still works normally if the executor does
-- not provide readfile/writefile/isfile. Active toggles are intentionally NOT saved.
ENH.SettingsFile = "r0onk_menu_settings_v2.json"
ENH.CanPersist = type(readfile) == "function" and type(writefile) == "function"
ENH.AllSettings = { version = 2, global = {}, games = {} }

if ENH.CanPersist then
	pcall(function()
		local exists = type(isfile) ~= "function" or isfile(ENH.SettingsFile)
		if exists then
			local decoded = HttpService:JSONDecode(readfile(ENH.SettingsFile))
			if type(decoded) == "table" then ENH.AllSettings = decoded end
		end
	end)
end

ENH.AllSettings.version = 2
ENH.AllSettings.global = type(ENH.AllSettings.global) == "table" and ENH.AllSettings.global or {}
ENH.AllSettings.games = type(ENH.AllSettings.games) == "table" and ENH.AllSettings.games or {}
do
	local placeKey = tostring(game.PlaceId)
	ENH.AllSettings.games[placeKey] = type(ENH.AllSettings.games[placeKey]) == "table" and ENH.AllSettings.games[placeKey] or {}
	ENH.GamePrefs = ENH.AllSettings.games[placeKey]
end

do
	local function enumKeyFromName(name, fallback)
		if type(name) == "string" then
			local ok, value = pcall(function() return Enum.KeyCode[name] end)
			if ok and value then return value end
		end
		return fallback
	end

	local savedKeys = type(ENH.AllSettings.global.Keys) == "table" and ENH.AllSettings.global.Keys or {}
	for action, fallback in pairs(CONFIG.Keys) do
		CONFIG.Keys[action] = enumKeyFromName(savedKeys[action], fallback)
	end
end

