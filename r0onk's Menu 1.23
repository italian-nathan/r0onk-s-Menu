-- ===== CONNECTION HELPERS =====
local function track(conn, bucket)
	if conn then
		table.insert(bucket or connections, conn)
	end
	return conn
end

local function disconnectBucket(bucket)
	for _, conn in ipairs(bucket) do
		if conn then
			conn:Disconnect()
		end
	end
	table.clear(bucket)
end

local function typingInTextBox()
	return UserInputService:GetFocusedTextBox() ~= nil
end

local function keyToText(key)
	if key == Enum.KeyCode.Backquote then
		return "`"
	end

	local name = key.Name
	name = name:gsub("LeftControl", "Ctrl")
	name = name:gsub("RightControl", "Ctrl")
	name = name:gsub("LeftAlt", "Alt")
	name = name:gsub("RightAlt", "Alt")
	name = name:gsub("LeftShift", "Shift")
	name = name:gsub("RightShift", "Shift")
	return name
end

local function clampInt(v, minValue, maxValue)
	return math.clamp(math.floor(tonumber(v) or minValue), minValue, maxValue)
end

ENH.SettingsSaveSerial = 0
local function saveSettingsNow()
	if not ENH.CanPersist then return end

	ENH.AllSettings.global.Keys = {}
	for action, key in pairs(CONFIG.Keys) do
		ENH.AllSettings.global.Keys[action] = key.Name
	end

	ENH.GamePrefs.FlySpeed = flySpeed
	ENH.GamePrefs.ESPMode = espMode
	ENH.GamePrefs.ESPHealthBars = espHealthBars
	ENH.GamePrefs.ESPNameTags = espNameTags
	ENH.GamePrefs.ESPDistanceTags = espDistanceTags
	ENH.GamePrefs.ESPTeamColors = espTeamColors
	ENH.GamePrefs.ESPMaxDistance = espMaxDistance
	ENH.GamePrefs.AimMaxDistance = aimMaxDistance
	ENH.GamePrefs.AimTeamOverrides = aimTeamOverrides
	ENH.GamePrefs.WalkSpeedOverride = ENH.WalkSpeedLocked and walkSpeed or nil
	ENH.GamePrefs.JumpPowerOverride = ENH.JumpPowerLocked and jumpPower or nil

	pcall(function()
		writefile(ENH.SettingsFile, HttpService:JSONEncode(ENH.AllSettings))
	end)
end

local function scheduleSaveSettings()
	if not ENH.CanPersist then return end
	ENH.SettingsSaveSerial += 1
	local serial = ENH.SettingsSaveSerial
	task.delay(0.15, function()
		if alive and serial == ENH.SettingsSaveSerial then
			saveSettingsNow()
		end
	end)
end

local function refreshHeaderGreeting()
	if ENH.HeaderHintLabel then
		ENH.HeaderHintLabel.Text = "Welcome " .. player.Name
	end
end

local function getCharacter()
	return player.Character
end

local function getHumanoid(char)
	char = char or getCharacter()
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function getHRP(char)
	char = char or getCharacter()
	if not char then return nil end

	local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildWhichIsA("Humanoid", true)
	return (hum and hum.RootPart)
		or char:FindFirstChild("HumanoidRootPart", true)
		or char.PrimaryPart
		or char:FindFirstChild("UpperTorso", true)
		or char:FindFirstChild("Torso", true)
		or char:FindFirstChild("LowerTorso", true)
		or char:FindFirstChild("Head", true)
end

-- ===== UI ROOT =====
local gui = Instance.new("ScreenGui")
gui.Name = "r0onk_Menu"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 999999

local function parentGuiSafely(screenGui)
	local parent = nil

	pcall(function()
		if type(gethui) == "function" then
			parent = gethui()
		elseif type(get_hidden_gui) == "function" then
			parent = get_hidden_gui()
		end
	end)

	if parent then
		pcall(function() screenGui.Parent = parent end)
	end

	if not screenGui.Parent then
		pcall(function()
			if syn and type(syn.protect_gui) == "function" then
				syn.protect_gui(screenGui)
			end
			screenGui.Parent = CoreGui
		end)
	end

	if not screenGui.Parent then
		screenGui.Parent = player:WaitForChild("PlayerGui")
	end
end

parentGuiSafely(gui)

local espFolder = Instance.new("Folder")
espFolder.Name = "r0onk_ESP"
espFolder.Parent = gui

